# Environment Configuration for Polygon Arbitrage Bot
# Copy to .env and fill in your values

# ─── RPC Endpoints ───────────────────────────────────────────────────────────
# Primary HTTP RPC (Polygon mainnet)
POLYGON_RPC_HTTP=https://polygon-rpc.com
# Secondary HTTP RPC for fallback
POLYGON_RPC_HTTP_FALLBACK=https://polygon-bor-rpc.publicnode.com
# WebSocket RPC for block subscriptions
POLYGON_RPC_WS=wss://polygon-bor-rpc.publicnode.com
# Optional WS fallback (approved)
POLYGON_RPC_WS_FALLBACK=wss://polygon-heimdall-rpc.publicnode.com:443/websocket
# Optional comma-separated extra HTTP endpoints for probing/rotation
POLYGON_RPC_HTTP_CANDIDATES=https://polygon-bor-rpc.publicnode.com,https://polygon-rpc.com,https://rpc.ankr.com/polygon,https://polygon.llamarpc.com
# Optional comma-separated extra WS endpoints for probing/rotation
POLYGON_RPC_WS_CANDIDATES=wss://polygon-bor-rpc.publicnode.com,wss://polygon-heimdall-rpc.publicnode.com:443/websocket

# ─── Wallet ──────────────────────────────────────────────────────────────────
# Private key of the executor wallet (DO NOT COMMIT)
PRIVATE_KEY=

# ─── Execution Parameters ────────────────────────────────────────────────────
# Minimum net profit in USD to execute a trade
MIN_PROFIT_USD=5.0
# Maximum gas price (Gwei) willing to pay
MAX_GAS_PRICE_GWEI=2.0
# Maximum slippage tolerance (0.005 = 0.5%)
MAX_SLIPPAGE=0.005
# Number of parallel price-fetch workers
DISCOVERY_WORKERS=8
# Poll interval in milliseconds when not using WebSocket
POLL_INTERVAL_MS=500
# Enable pending-transaction ingestion when a WebSocket provider supports it
ENABLE_PENDING_FEED=true
# Max runtime event history retained in memory
MARKET_EVENT_BUFFER_SIZE=512
# Max acceptable quote age before execution is paused
QUOTE_MAX_AGE_MS=4000
# Allow future private-relay execution policy selection
ENABLE_PRIVATE_RELAY=false
# Allow future atomic flash execution policy selection
ENABLE_ATOMIC_FLASH=false
# Backpressure cap for pending tx hashes accepted per block
MAX_PENDING_TX_PER_BLOCK=128

# ─── Flash Loan ──────────────────────────────────────────────────────────────
# Aave v3 pool address on Polygon (used for flash loans)
AAVE_POOL=0x794a61358D6845594F94dc1DB02A252b5b4814aD

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
