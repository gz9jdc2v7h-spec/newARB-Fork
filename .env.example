# Environment Configuration for Polygon Arbitrage Bot
# Copy to .env and fill in your values

# ─── RPC Endpoints ───────────────────────────────────────────────────────────
# Primary HTTP RPC (Polygon mainnet)
POLYGON_RPC_HTTP=https://polygon-rpc.com
# Secondary HTTP RPC for fallback
POLYGON_RPC_HTTP_FALLBACK=https://polygon-bor-rpc.publicnode.com
# WebSocket RPC for block subscriptions
POLYGON_RPC_WS=wss://polygon-bor-rpc.publicnode.com

# ─── Wallet ──────────────────────────────────────────────────────────────────
# Private key of the executor wallet (DO NOT COMMIT)
PRIVATE_KEY=

# ─── Execution Parameters ────────────────────────────────────────────────────
# Minimum net profit in USD to execute a trade
MIN_PROFIT_USD=5.0
# Maximum gas price (Gwei) willing to pay
MAX_GAS_PRICE_GWEI=2.0
# Maximum slippage tolerance (0.005 = 0.5%)
MAX_SLIPPAGE=0.005
# Number of parallel price-fetch workers
DISCOVERY_WORKERS=8
# Poll interval in milliseconds when not using WebSocket
POLL_INTERVAL_MS=500

# ─── Flash Loan ──────────────────────────────────────────────────────────────
# Aave v3 pool address on Polygon (used for flash loans)
AAVE_POOL=0x794a61358D6845594F94dc1DB02A252b5b4814aD

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
